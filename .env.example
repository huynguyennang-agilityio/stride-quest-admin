# Copy to .env.local for local development. Never commit .env.local.

# The StrideQuest backend server root (the local backend from claude-code-training).
# The API paths in contract/ already start with /api/v1.
API_BASE_URL=http://localhost:8000
# `real` calls the backend; `mock` (development only) serves the contract fixtures through MSW.
API_MODE=real

# Only for `npm run e2e`: a LOCAL admin account (see the README). Keep these in .env.local.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
